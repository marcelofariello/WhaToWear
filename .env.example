# Google GenAI API Key (kept strictly server-side; never expose in browser code)
GEMINI_API_KEY=your_gemini_api_key_here

# Studio E-Commerce Product Photo Model (switch to gemini-3-pro-image for maximum studio fidelity)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Clothing Recognition Model (Structured Outputs + High Media Resolution)
GEMINI_RECOGNITION_MODEL=gemini-3.8-flash

# Local server port
PORT=3000
