{
  "name": "whatowear",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "WTW · WhaToWear wardrobe stylist with server-side Gemini studio product imagery and multimodal garment recognition",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "verify:images": "npm run build && node dist/scripts/verify-garment-gen.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
